# Application Configuration
APP_ENV=development
APP_PORT=3000

# Database Configuration
# For local development, use localhost
# For Docker/Coolify deployment, use the service name (e.g., pgsqldb)
TEST_DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_db
DB_USER=postgres
DB_PASS=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db?schema=public

# JWT Configuration
# Token expiration times in seconds (86400 = 24 hours, 604800 = 7 days)
JWT_ACCESS_TOKEN_EXP_IN_SEC=86400
JWT_REFRESH_TOKEN_EXP_IN_SEC=604800
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_BASE64=
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

# Admin User Configuration
DEFAULT_ADMIN_USER_EMAIL=admin@example.com
DEFAULT_ADMIN_USER_USERNAME=default-admin
DEFAULT_ADMIN_USER_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# File Storage Configuration
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=500

# CORS Configuration (optional)
# CORS_ORIGINS=http://localhost:3001,https://yourdomain.com

# Email/SMTP Configuration
# For development, you can use a service like Mailtrap or MailHog
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lms.com

# Redis Configuration (for Bull queue)
# For local development, use localhost
# For Docker/Coolify deployment, use the service name (e.g., redis)
REDIS_HOST=localhost
REDIS_PORT=6379
